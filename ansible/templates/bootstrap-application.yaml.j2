---
# This template is used to generate the Root Application
# It is applied by the gitops_bootstrap role

apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: workshop-root
  namespace: {{ gitops.instance_namespace }}
  labels:
    app.kubernetes.io/name: workshop-root
    app.kubernetes.io/part-of: developer-lightspeed-workshop
    app.kubernetes.io/managed-by: ansible
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: {{ gitops.repo_url }}
    targetRevision: {{ gitops.repo_revision }}
    path: {{ gitops.repo_path }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ gitops.instance_namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
      allowEmpty: true
    syncOptions:
      - ServerSideApply=true
      - PrunePropagationPolicy=foreground
      - PruneLast=true
      - RespectIgnoreDifferences=true
      - ApplyOutOfSyncOnly=true
  ignoreDifferences:
    # OAuth may have other identity providers - ignore additions
    - group: config.openshift.io
      kind: OAuth
      name: cluster
      jsonPointers:
        - /spec/identityProviders
